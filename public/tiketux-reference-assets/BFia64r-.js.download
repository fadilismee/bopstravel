hts-stay-outline"}],DE="5",NE="2",ME="5",FE=[{route:"schedule",meta_title:"Pilih Jadwal Keberangkatan | Tiketux",meta_description:"Pilih jadwal keberangkatan travel, shuttle, dan bus favoritmu di Tiketux."},{route:"select-seat",meta_title:"Pilih Kursi | Tiketux",meta_description:"Pilih kursi perjalananmu di Tiketux."},{route:"information-passengers",meta_title:"Data Penumpang | Tiketux",meta_description:"Lengkapi data penumpang untuk melanjutkan pemesanan tiket di Tiketux."},{route:"confirmation-order",meta_title:"Konfirmasi Pesanan | Tiketux",meta_description:"Periksa dan konfirmasi pesanan tiketmu sebelum membayar di Tiketux."},{route:"detail-order",meta_title:"Detail Pesanan | Tiketux",meta_description:"Lihat detail pesanan tiket kamu di Tiketux."}],jE="false",$E="false",VE=[{dial_code:"+62",name:"id",icon:"https://cdn.all.tiketux.id/tiketux/images/file/20260928/3310c43d353824377c85fc56994974dd.webp"}],BE="3000",UE=!0,HE="70,55,40",GE={slider:"40",popup:"40",article:"60",logo:"15"},WE="cdn.all.tiketux.id",zE="",qE="https://cdn.all.tiketux.id/tiketux/images/file/20260409/17a8b0d4777806ff590a22eff8c5ed47.webp",KE=!0,JE=!1,YE="https://cdn.all.tiketux.id/tiketux/images/file/20260605/d5035926bb70c68bd2ee98fb4ba8e682.webp",XE="STRING",QE={start_date:"2025-01-01",end_date:"2025-12-31"},ZE=[{code:"brand-assets",start_date:"2026-02-03",end_date:"2026-02-31"}],ew=[{key:"list_path_other",list:["/","/blog","/user-privacy","/how-topay","/tiket","/list-kota","/list-operator","/about"]},{key:"list_path_tiket-bus",list:[]},{key:"list_blog",list:[]},{key:"list_operator",list:[]}],tw="2027-12-31",nw="['app/schedule', 'app/detail-group-by-partner-schedule', 'app/schedule/detail-facility', '/app/select-seat', '/app/information-passengers', 'app/detail-schedule-standalone', 'app/list-voucher-standalone', 'app/confirmation-order', '/app/order/', '/login']",ow="3",rw="3",aw="3",sw="['/tiket','/','/blog','/about']",iw=!0,cw=[{cors_value:"https://stg.v2.tiketux.com"},{cors_value:"https://www.tiketux.com"}],lw=' <h1 style="color: #16305c; font-size: 1.4rem; font-weight: 700; border-left: 4px solid #f2994a; padding-left: 14px; margin-top: 0; margin-bottom: 16px;">Tiketux</h1> <p style="margin: 0 0 18px; font-size: 1rem;">Tiketux merupakan platform pesan tiket bus dan tiket travel dari PT. Trans Berjaya Khatulistiwa. Menyediakan layanan pemesanan tiket transportasi darat di antar kota dan antar provinsi.</p> <p style="margin: 0 0 18px; font-size: 1rem;">Pengguna dapat dengan mudah memesan tiket bus dan travel di Tiketux dengan pemilihan rute pulang-pergi (round trip) dalam satu kali pemesanan.</p>  <h2 style="color: #16305c; font-size: 1.4rem; font-weight: 700; border-left: 4px solid #f2994a; padding-left: 14px; margin-top: 40px; margin-bottom: 16px;">Rute yang Dilayani</h2> <p style="margin: 0 0 18px; font-size: 1rem;">Berdiri sejak tahun 2013, Tiketux sudah melayani perjalanan ke berbagai kota di Jawa Barat, seperti:</p> <ul style="margin: 0 0 18px; padding-left: 24px;"> <li style="margin-bottom: 6px;">Bandung ke Jakarta</li> <li style="margin-bottom: 6px;">Jakarta ke Bandung</li> <li style="margin-bottom: 6px;">Bandung ke Bekasi</li> <li style="margin-bottom: 6px;">Bandung ke Tangerang</li> </ul> <p style="margin: 0 0 18px; font-size: 1rem;">Dan rute lintas provinsi:</p> <ul style="margin: 0 0 18px; padding-left: 24px;"> <li style="margin-bottom: 6px;">Bandung ke Semarang</li> <li style="margin-bottom: 6px;">Jakarta ke Semarang</li> <li style="margin-bottom: 6px;">Dan rute antar Jawa-Sumatera</li> </ul>  <h2 style="color: #16305c; font-size: 1.4rem; font-weight: 700; border-left: 4px solid #f2994a; padding-left: 14px; margin-top: 40px; margin-bottom: 16px;">Metode Pembayaran</h2> <p style="margin: 0 0 18px; font-size: 1rem;">Tiketux menawarkan kemudahan dalam pembayaran tiket bus dan travel melalui 20 pilihan metode pembayaran melalui Alfamart, virtual account BCA, Mandiri, dan bank lainnya, hingga QRIS, OVO, dan ShopeePay.</p>  <h2 style="color: #16305c; font-size: 1.4rem; font-weight: 700; border-left: 4px solid #f2994a; padding-left: 14px; margin-top: 40px; margin-bottom: 16px;">Dipercaya Pengguna</h2> <p style="margin: 0 0 18px; font-size: 1rem;">Tiketux telah dipercaya oleh lebih dari seribu pengguna aktif setiap bulannya.</p>  <h2 style="color: #16305c; font-size: 1.4rem; font-weight: 700; border-left: 4px solid #f2994a; padding-left: 14px; margin-top: 40px; margin-bottom: 16px;">Unduh Aplikasi Mobile</h2> <p style="margin: 0 0 18px; font-size: 1rem;">Untuk lebih memudahkan transaksi, Tiketux juga menyediakan aplikasi mobile yang dapat diunduh melalui:</p> <ul style="margin: 0 0 18px; padding-left: 24px;"> <li style="margin-bottom: 6px;"><a href="https://play.google.com/store/apps/details?id=com.trust.android.tiketux&hl=id" style="color: #16305c; font-weight: 600; text-decoration: none;">Playstore</a></li> <li style="margin-bottom: 6px;"><a href="https://apps.apple.com/us/app/tiketux/id1615520069" style="color: #16305c; font-weight: 600; text-decoration: none;">Appstore</a></li> </ul>',uw={enabled:!0,events:{url_home_guest:{enabled:!0,threshold:0,window:0,delay:0,dismiss_duration:604800,require_voucher:!1,priority:10,url_notif:"/v1/guest-conversion/url-home-guest",url_timeout:5,url_cache:300,rules:[],display:{desktop:{type:"strip",position:"top",size:"sm",dismissible:!0},mobile:{type:"strip",position:"bottom",size:"sm",dismissible:!0}},action_primary:"login",action_secondary:"dismiss",copy:{id:{title:"Jangan Lewatkan Harga Spesial💸",body:"Login dan dapatkan akses promo dan penawaran spesial di Tiketux.",cta_primary:"Login",cta_secondary:"Nanti saja"},en:{title:"Don’t Miss Out on Special Fares!",body:"Login and unlock more deals and special offers on Tiketux.",cta_primary:"Login",cta_secondary:"Later"}}},btn_search_schedule_guest:{enabled:!0,threshold:3,window:3600,delay:2,dismiss_duration:86400,require_voucher:!0,priority:20,url_notif:"/v1/guest-conversion/btn-search-schedule-guest",url_timeout:5,url_ca